# Local Ollama is the default provider. No API key is needed for Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
DEVMIND_MODEL=qwen2.5-coder:14b

# Hosted provider keys are optional. Configure only the provider you use.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
E2B_API_KEY=

DEVMIND_HOST=127.0.0.1
DEVMIND_PORT=8000
# Set true only for a hosted deployment configured with E2B_API_KEY.
DEVMIND_PUBLIC_MODE=false
# DEVMIND_WORKSPACES=/absolute/path/to/private/workspaces
